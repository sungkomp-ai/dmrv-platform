// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  // URL is configured in prisma.config.ts (Prisma 7 pattern)
}

// ─── Core Models ──────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  methodology String   @default("T-VER") // T-VER, IPCC-2023, T-VER-FOREST
  status      String   @default("Active") // Active, Pending, Suspended, Completed
  areaHa      Float    @default(0)
  location    String   @default("")
  region      String   @default("")
  country     String   @default("Thailand")
  centerLat   Float    @default(13.75)
  centerLng   Float    @default(100.5)
  province    String   @default("")
  startDate   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plots             Plot[]
  credits           CarbonCredit[]
  certificates      Certificate[]
  ingestionLogs     IngestionLog[]
  submissions       Submission[]
  auditLogs         AuditLog[]
  iotSensors        IoTSensor[]
  vvbReviews        VVBReview[]
  conflictCases     ConflictCase[]
  bufferPoolEntries BufferPoolEntry[]
  forwardContracts  ForwardContract[]
  deviceRegistrations DeviceRegistration[]
}

model Plot {
  id          String   @id @default(cuid())
  plotId      String
  projectId   String
  coordinates String   @default("[]") // JSON: [[lat, lng], ...]
  ownerInfo   String   @default("")
  trackType   String   @default("forest") // forest, biochar, awd, biogas, solar
  areaHa      Float    @default(0)
  status      String   @default("REGISTERED") // REGISTERED, VERIFIED, ACTIVE, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CarbonCredit {
  id        String   @id @default(cuid())
  tokenId   String   @unique
  projectId String
  amount    Float    @default(0)
  status    String   @default("Available") // Available, Traded, Retired, Buffered
  buyer     String   @default("") // Buyer name when traded/retired
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bufferPoolEntry BufferPoolEntry?
  settlement      Settlement?
}

model Certificate {
  id                String   @id @default(cuid())
  projectId         String
  certId            String   @default("") // T-VER certificate reference ID
  trackType         String   @default("forest") // forest, biochar, awd, biogas, solar
  status            String   @default("SUBMITTED") // SUBMITTED, APPROVED, REJECTED, REVOKED
  amountTco2e       Float    @default(0) // Certified emission reductions in tCO2e
  issuedBy          String   @default("TGO")
  validator         String   @default("") // VVB or T-VER validator name
  masterCertId      String   @default("") // Master certificate ID issued on approval
  certificateNumber String   @default("")
  validFrom         DateTime @default(now())
  validUntil        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditTrail    AuditTrailEntry[]
}

model IngestionLog {
  id             String   @id @default(cuid())
  projectId      String
  sourceType     String   // satellite, iot, drone, photo, lidar, manual
  activityType   String   // monitoring, verification, measurement
  payload        String   @default("{}")
  evidenceUrl    String   @default("")
  integrityHash  String   @default("")
  classification String   @default("PUBLIC") // PUBLIC, CONFIDENTIAL
  isEncrypted    Boolean  @default(false)
  timestamp      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Submission {
  id          String    @id @default(cuid())
  projectId   String
  type        String    @default("VERIFICATION") // VERIFICATION, CERTIFICATION, MONITORING
  status      String    @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  data        String    @default("{}")
  submittedBy String    @default("")
  reviewedBy  String    @default("")
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  agentName String
  action    String
  projectId String?
  details   String   @default("{}")
  severity  String   @default("INFO") // INFO, WARNING, ERROR, CRITICAL
  timestamp DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Alert {
  id        String   @id @default(cuid())
  severity  String   @default("INFO") // INFO, WARNING, CRITICAL
  message   String
  resolved  Boolean  @default(false)
  timestamp DateTime @default(now())
}

model IoTSensor {
  id          String   @id @default(cuid())
  projectId   String
  sensorId    String
  sensorType  String   @default("soil_moisture") // soil_moisture, temperature, humidity, ch4, co2, water_level, ph, wind_speed, solar_irradiance
  lat         Float    @default(0)
  lng         Float    @default(0)
  status      String   @default("online") // online, offline, maintenance
  lastReading Float    @default(0)
  unit        String   @default("")
  battery     Int      @default(100)
  lastSeen    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── Enterprise Models: Verification & Validation Hub ─────────────────────

model VVBReview {
  id             String   @id @default(cuid())
  projectId      String
  reviewerOrg    String   @default("") // VVB organization name
  reviewerName   String   @default("")
  reviewType     String   @default("VALIDATION") // VALIDATION, VERIFICATION, PERIODIC_VERIFICATION
  status         String   @default("PENDING") // PENDING, IN_PROGRESS, APPROVED, REJECTED, REQUESTED_INFO
  evidenceRefs   String   @default("[]") // JSON: list of evidence URLs/reference IDs
  findings       String   @default("{}") // JSON: structured findings
  recommendation String   @default("") // approve, reject, request_more_info
  comments       String   @default("")
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ConflictCase {
  id           String    @id @default(cuid())
  projectId    String
  title        String
  description  String    @default("")
  sourceA      String    @default("{}") // JSON: first data source info
  sourceB      String    @default("{}") // JSON: second data source info
  conflictType String    @default("DATA_MISMATCH") // DATA_MISMATCH, THRESHOLD_EXCEEDED, INTEGRITY_FAIL, SPATIAL_MISMATCH
  severity     String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status       String    @default("FLAGGED") // FLAGGED, IN_REVIEW, RESOLVED, ESCALATED
  resolution   String    @default("")
  resolvedBy   String    @default("")
  evidenceUrl  String    @default("")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── Enterprise Models: Trust & Transparency ──────────────────────────────

model AuditTrailEntry {
  id            String   @id @default(cuid())
  certificateId String
  eventType     String   @default("ORIGIN") // ORIGIN, QUANTIFY, VERIFY, CERTIFY, MINT, TRADE, RETIRE, BUFFER
  previousHash  String   @default("")
  dataHash      String   @default("")
  merkleRoot    String   @default("")
  metadata      String   @default("{}") // JSON: event-specific data (de-identified)
  timestamp     DateTime @default(now())

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
}

model DeviceRegistration {
  id              String   @id @default(cuid())
  projectId       String
  deviceId        String
  deviceType      String   @default("iot") // iot, drone, satellite, lidar, manual
  manufacturer    String   @default("")
  model           String   @default("")
  firmwareVersion String   @default("")
  publicKey       String   @default("") // Hardware-level cryptographic signing key
  signingStatus   String   @default("UNSIGNED") // UNSIGNED, SIGNED, EXPIRED, REVOKED
  connectionStatus String  @default("disconnected") // connected, disconnected, maintenance
  healthStatus    String   @default("UNKNOWN") // HEALTHY, DEGRADED, CRITICAL, UNKNOWN
  lastCalibration DateTime?
  batteryLevel    Int      @default(100)
  signalStrength  Int      @default(0) // dBm
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── Enterprise Models: Finance & Risk Management ─────────────────────────

model BufferPoolEntry {
  id            String   @id @default(cuid())
  projectId     String
  creditId      String   @unique
  amount        Float    @default(0) // tCO2e held in buffer
  uncertaintyPct Float   @default(0) // Uncertainty percentage
  bufferPct     Float    @default(0) // Buffer deduction percentage
  riskCategory  String   @default("MEDIUM") // LOW, MEDIUM, HIGH, VERY_HIGH
  reason        String   @default("")
  releasedAt    DateTime? // When buffer credits are released
  createdAt     DateTime @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credit  CarbonCredit  @relation(fields: [creditId], references: [id], onDelete: Cascade)
}

model ForwardContract {
  id            String    @id @default(cuid())
  projectId     String
  sellerName    String    @default("")
  buyerName     String    @default("")
  creditAmount  Float     @default(0) // tCO2e
  pricePerUnit  Float     @default(0) // USD per tCO2e
  totalValue    Float     @default(0) // USD
  deliveryDate  DateTime
  status        String    @default("DRAFT") // DRAFT, PENDING, APPROVED, ACTIVE, COMPLETED, CANCELLED, DEFAULTED
  terms         String    @default("{}") // JSON: contract terms
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── Enterprise Models: User Experience & Integration ─────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  key         String    @unique
  permissions String    @default("[]") // JSON: list of permission scopes
  lastUsed    DateTime?
  status      String    @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  createdBy   String    @default("")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
}

model Webhook {
  id             String    @id @default(cuid())
  url            String
  events         String    @default("[]") // JSON: list of event types
  secret         String    @default("")
  status         String    @default("ACTIVE") // ACTIVE, PAUSED, FAILED
  lastDelivery   DateTime?
  failureCount   Int       @default(0)
  lastFailure    String    @default("")
  createdBy      String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model MethodologyRule {
  id                String   @id @default(cuid())
  name              String
  methodology       String   @default("T-VER")
  trackType         String   @default("forest")
  version           String   @default("1.0")
  description       String   @default("")
  formula           String   @default("{}") // JSON: formula definition with variables
  parameters        String   @default("[]") // JSON: parameter definitions
  conditions        String   @default("[]") // JSON: validation conditions
  status            String   @default("DRAFT") // DRAFT, ACTIVE, DEPRECATED
  createdBy         String   @default("")
  aiGenerated       Boolean  @default(false) // Whether AI helped generate this rule
  aiGenerationId    String   @default("") // Reference to AI generation session
  sourceTemplate    String   @default("") // Template used for generation (e.g., VERRA-VM0042)
  calculationNodes  String   @default("[]") // JSON: visual node definitions for No-Code editor
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ─── AI Methodology Generative Studio ────────────────────────────────────

model AIGenerationSession {
  id              String   @id @default(cuid())
  prompt          String   // User's natural language description
  methodology     String   @default("T-VER")
  trackType       String   @default("forest")
  generatedFormula String  @default("{}") // JSON: AI-generated formula
  generatedParams String   @default("[]") // JSON: AI-generated parameters
  generatedConditions String @default("[]") // JSON: AI-generated conditions
  generatedNodes  String   @default("[]") // JSON: AI-generated calculation nodes
  aiModel         String   @default("z-ai-llm") // AI model used
  status          String   @default("GENERATING") // GENERATING, COMPLETED, FAILED, APPLIED
  ruleId          String   @default("") // Applied MethodologyRule ID if status=APPLIED
  feedback        String   @default("") // User feedback on generation
  createdBy       String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Cross-Chain Bridge & Registry Link ──────────────────────────────────

model CrossChainBridge {
  id                String   @id @default(cuid())
  name              String   // Connection name
  registryType      String   // VERRA, GOLD_STANDARD, I_REC, CDM, T_VER, CUSTOM
  endpoint          String   @default("") // API endpoint URL
  apiKeyRef         String   @default("") // Reference to stored API key (encrypted)
  accountId         String   @default("") // Account ID at external registry
  accountName       String   @default("") // Account display name
  bridgeProtocol    String   @default("API") // API, POLYGON_BRIDGE, ETHEREUM_BRIDGE, COSMOS_IBC, CUSTOM
  status            String   @default("PENDING") // PENDING, CONNECTED, SYNCING, ERROR, DISCONNECTED
  lastSyncAt        DateTime? // Last successful synchronization
  syncInterval      Int      @default(3600) // Sync interval in seconds
  totalCreditsSynced Float   @default(0) // Total credits synced through this bridge
  metadata          String   @default("{}") // JSON: additional config
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions BridgeTransaction[]
}

// ─── Settlement Model ──────────────────────────────────────────────────────

model Settlement {
  id        String   @id @default(cuid())
  creditId  String   @unique // Reference to CarbonCredit
  assetId   String   @default("") // Token ID of the settled asset
  amount    Float    @default(0) // Settlement amount
  status    String   @default("pending") // pending, processed, failed
  timestamp DateTime @default(now())

  credit CarbonCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
}

model BridgeTransaction {
  id              String   @id @default(cuid())
  bridgeId        String   // Reference to CrossChainBridge
  txType          String   // MINT, TRANSFER, RETIRE, SYNC, VERIFY
  direction       String   // OUTBOUND, INBOUND // OUTBOUND = from our platform to external, INBOUND = from external to our platform
  creditAmount    Float    @default(0) // tCO2e
  creditTokenId   String   @default("") // Our platform token ID
  externalRef     String   @default("") // External registry reference/ID
  externalStatus  String   @default("") // Status at external registry
  txHash          String   @default("") // Blockchain tx hash (if applicable)
  status          String   @default("PENDING") // PENDING, SUBMITTED, CONFIRMED, FAILED, ROLLED_BACK
  errorMessage    String   @default("")
  metadata        String   @default("{}") // JSON: additional transaction data
  initiatedBy     String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bridge CrossChainBridge @relation(fields: [bridgeId], references: [id], onDelete: Cascade)
}

// ─── IoT Ingestion Models ──────────────────────────────────────────────────

model IoTEdgeNode {
  id              String   @id @default(cuid())
  nodeId          String   @unique // Unique edge node identifier (e.g., EDGE-BKK-001)
  name            String   // Display name
  nameTh          String   @default("") // Thai name
  province        String   @default("")
  lat             Float    @default(0)
  lng             Float    @default(0)
  firmwareVersion String   @default("1.0.0")
  protocol        String   @default("MQTT") // MQTT, HTTP, WebSocket, LoRaWAN
  status          String   @default("offline") // online, offline, maintenance, provisioning
  lastHeartbeat   DateTime?
  batteryLevel    Int      @default(100)
  signalStrength  Int      @default(0) // dBm
  totalReadings   Int      @default(0)
  certificationKey String  @default("") // Public key for data signing
  signingStatus   String   @default("UNSIGNED") // UNSIGNED, SIGNED, EXPIRED, REVOKED
  metadata        String   @default("{}") // JSON: additional config (sampling rate, buffer size, etc.)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sensors         IoTSensorV2[]
  readings        IoTSensorReading[]
  batchJobs       IoTBatchJob[]
  soilPlots       SoilCarbonPlot[]
  buildings       LowCarbonBuilding[]
}

model IoTSensorV2 {
  id            String   @id @default(cuid())
  edgeNodeId    String
  sensorId      String   @unique // Sensor identifier (e.g., CH4-SENSOR-001)
  sensorType    String   // ch4, co2, temperature, humidity, soil_moisture, water_level, ph, wind_speed, solar_irradiance, dissolved_oxygen, cod, bod, nitrogen, phosphorus
  manufacturer  String   @default("")
  model         String   @default("")
  unit          String   @default("") // ppm, °C, %, mg/L, m, pH, m/s, W/m²
  minRange      Float    @default(0)
  maxRange      Float    @default(100)
  resolution    Float    @default(0.01)
  accuracy      Float    @default(0) // ±value
  samplingRate  Int      @default(60) // seconds between readings
  status        String   @default("active") // active, inactive, calibration, error
  lastReading   Float    @default(0)
  lastReadingAt DateTime?
  calibrationDate DateTime?
  metadata      String   @default("{}") // JSON: sensor-specific config
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  edgeNode      IoTEdgeNode     @relation(fields: [edgeNodeId], references: [id], onDelete: Cascade)
  readings      IoTSensorReading[]
}

model IoTSensorReading {
  id              String   @id @default(cuid())
  edgeNodeId      String
  sensorId        String?  // Reference to IoTSensorV2.sensorId
  sensorType      String
  value           Float
  unit            String   @default("")
  timestamp       DateTime // Actual measurement time
  receivedAt      DateTime @default(now()) // Server receipt time
  ingestionMode   String   @default("realtime") // realtime, batch
  batchJobId      String?  // Reference to IoTBatchJob if batch mode
  qualityFlag     String   @default("RAW") // RAW, VALIDATED, CERTIFIED, REJECTED, ANOMALY
  integrityHash   String   @default("") // SHA-256 of (sensorId + value + timestamp)
  signature       String   @default("") // Edge node digital signature
  metadata        String   @default("{}") // JSON: additional reading metadata
  createdAt       DateTime @default(now())

  edgeNode       IoTEdgeNode    @relation(fields: [edgeNodeId], references: [id], onDelete: Cascade)
  sensor         IoTSensorV2?   @relation(fields: [sensorId], references: [sensorId], onDelete: SetNull)
  batchJob       IoTBatchJob?   @relation(fields: [batchJobId], references: [id], onDelete: SetNull)
}

model IoTBatchJob {
  id              String   @id @default(cuid())
  edgeNodeId      String
  fileName        String   @default("")
  fileType        String   @default("CSV") // CSV, JSON, XML, PARQUET
  totalRecords    Int      @default(0)
  processedRecords Int     @default(0)
  validRecords    Int      @default(0)
  rejectedRecords Int      @default(0)
  anomalyRecords  Int      @default(0)
  status          String   @default("UPLOADED") // UPLOADED, VALIDATING, PROCESSING, CERTIFYING, COMPLETED, FAILED
  certificationStatus String @default("PENDING") // PENDING, CERTIFIED, PARTIAL, REJECTED
  merkleRoot      String   @default("") // Merkle root hash of all readings in batch
  integrityReport String   @default("{}") // JSON: detailed integrity report
  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String   @default("")
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  edgeNode       IoTEdgeNode      @relation(fields: [edgeNodeId], references: [id], onDelete: Cascade)
  readings       IoTSensorReading[]
  certificationLogs IoTCertificationLog[]
}

model IoTCertificationLog {
  id              String   @id @default(cuid())
  batchJobId      String?  // Reference to IoTBatchJob (null for realtime certification)
  batchJob        IoTBatchJob?  @relation(fields: [batchJobId], references: [id], onDelete: SetNull)
  edgeNodeId      String   @default("")
  sensorId        String   @default("")
  readingCount    Int      @default(0)
  passedCount     Int      @default(0)
  failedCount     Int      @default(0)
  anomalyCount    Int      @default(0)
  certificationType String @default("BATCH") // BATCH, REALTIME, PERIODIC
  status          String   @default("PENDING") // PENDING, IN_PROGRESS, CERTIFIED, REJECTED
  integrityHash   String   @default("") // SHA-256 of entire certification
  merkleRoot      String   @default("") // Merkle root for batch certification
  rules           String   @default("[]") // JSON: list of certification rules applied
  report          String   @default("{}") // JSON: detailed certification report
  certifiedBy     String   @default("")
  certifiedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Soil Carbon Sequestration Agent Models ──────────────────────────────
// เกษตรกักตะกอนดิน (Sediment Trap Agriculture) — พื้นที่สูง/ลาดชัน
// ทำแปลงปลูกเป็นชั้นๆ (Terrace) + ฝายชะลอน้ำ (Check Dam) ในแต่ละชั้น

model SoilCarbonPlot {
  id                String   @id @default(cuid())
  plotId            String   @unique // e.g., SOIL-CMD-001
  name              String
  nameTh            String   @default("")
  province          String   @default("")
  lat               Float    @default(0)
  lng               Float    @default(0)
  altitudeMasl      Float    @default(0) // เมตรเหนือระดับน้ำทะเล (Metres Above Sea Level)
  slopeDegree       Float    @default(0) // องศาความลาดชัน (0-90°)
  slopeAspect       String   @default("N") // ทิศทางลาดชัน: N, NE, E, SE, S, SW, W, NW
  areaRai           Float    @default(0) // ไร่ (Thai unit)
  areaHa            Float    @default(0) // Hectares (1 rai = 0.16 ha)
  terraceCount      Int      @default(0) // จำนวนชั้นปลูก (Terrace layers)
  terraceWidthM     Float    @default(0) // ความกว้างรวมของแต่ละชั้น (2.0-2.7 เมตร) = คันขอบ + พื้นที่ปลูก
  plantingAreaWidthM Float   @default(0) // ความกว้างพื้นที่ปลูกพืชหลัก (1.5-2.0 เมตร)
  ridgeWidthMPlot   Float    @default(0) // ความกว้างคันขอบปลูกหญ้าแฝก (0.7-1.0 เมตร)
  terraceHeightM    Float    @default(0) // ความสูงระหว่างชั้น (เมตร)
  checkDamCount     Int      @default(0) // จำนวนฝายชะลอน้ำ (Check Dams)
  checkDamType      String   @default("STONE") // ประเภทฝาย: STONE, CONCRETE, LOG, GABION, VEGETATION
  landUseType       String   @default("terraced_farming") // terraced_farming, contour_farming, sediment_trap, agroforestry, conservation
  previousLandUse   String   @default("") // การใช้ประโยชน์ก่อนหน้า: slash_and_burn, conventional, degraded_forest, etc.
  vetiverGrassCoveragePct Float @default(0) // % พื้นที่ปลูกหญ้าแฝกบนคันขอบรวมทั้งแปลง
  soilType          String   @default("") // Clay, Loam, Sandy Loam, etc.
  cropType          String   @default("") // Rice, Cassava, Sugarcane, Rubber, Fruit trees, Coffee, etc.
  practiceType      String   @default("sediment_trap") // sediment_trap, contour_planting, terraced, strip_cropping, agroforestry
  baselineSOC       Float    @default(0) // tC/ha baseline soil organic carbon
  projectSOC        Float    @default(0) // tC/ha project scenario SOC
  baselineSediment  Float    @default(0) // t/ha/yr baseline soil erosion/sediment loss
  projectSediment   Float    @default(0) // t/ha/yr project sediment trapped
  sedimentTrapRate  Float    @default(0) // % อัตรากักตะกอนดิน
  baselineEmission  Float    @default(0) // tCO2e/ha/yr baseline emissions
  projectEmission   Float    @default(0) // tCO2e/ha/yr project emissions
  emissionReduction Float    @default(0) // tCO2e/ha/yr net reduction
  monitoringYear    Int      @default(1)
  status            String   @default("REGISTERED") // REGISTERED, MONITORING, VERIFIED, CERTIFIED, SUSPENDED
  methodology       String   @default("T-VER-SOIL-01") // T-VER-SOIL-01, IPCC-2019-Ref, VERRA-VM0042
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  measurements      SoilCarbonMeasurement[]
  terraces          TerraceLayer[]
  checkDams         CheckDam[]
  edgeNodeId        String?
  edgeNode          IoTEdgeNode? @relation(fields: [edgeNodeId], references: [id], onDelete: SetNull)
}

// ชั้นปลูก (Terrace Layer) — แต่ละชั้นของแปลงขั้นบันได
model TerraceLayer {
  id                String   @id @default(cuid())
  plotId            String
  layerNumber       Int      // ลำดับชั้น (1 = ชั้นบนสุด, เพิ่มลงมาเรื่อยๆ)
  layerName         String   @default("") // เช่น "ชั้นที่ 1 - ปลูกผัก"
  layerNameTh       String   @default("") // ชื่อชั้นภาษาไทย
  elevationMasl     Float    @default(0) // ระดับความสูงของชั้นนี้ (ม.รทก.)
  widthM            Float    @default(0) // ความกว้างรวมของชั้น (2.0-2.7 เมตร) = ridgeWidthM + plantingAreaWidthM
  plantingAreaWidthM Float   @default(0) // ความกว้างพื้นที่ปลูกพืชหลัก (1.5-2.0 เมตร)
  heightM           Float    @default(0) // ความสูงจากชั้นถัดไป (เมตร)
  lengthM           Float    @default(0) // ความยาวตามแนวระดับ (เมตร)
  areaSqm           Float    @default(0) // พื้นที่ชั้นรวม (ตร.ม.)
  plantingAreaSqm   Float    @default(0) // พื้นที่ปลูกพืชหลัก (ตร.ม.)
  cropType          String   @default("") // พืชที่ปลูกในชั้นนี้
  soilDepthCm       Float    @default(0) // ความลึกดิน (ซม.)
  sedimentDepthCm   Float    @default(0) // ความหนาตะกอนดินที่สะสม (ซม.)
  waterFlowInLMin   Float    @default(0) // อัตราน้ำไหลเข้า (ลิตร/นาที)
  waterFlowOutLMin  Float    @default(0) // อัตราน้ำไหลออก (ลิตร/นาที)
  sedimentTrappedKg Float    @default(0) // ตะกอนดินที่ถูกกัก (กก.)
  organicCarbonPct  Float    @default(0) // SOC % ในตะกอนดิน
  socStockTcHa      Float    @default(0) // SOC stock (tC/ha)
  // --- ข้อมูลหญ้าแฝกบนคันขอบ (Vetiver Grass Ridge) ---
  ridgeWidthM       Float    @default(0) // ความกว้างคันขอบปลูกหญ้าแฝก (0.7-1.0 เมตร)
  vetiverGrassStatus String  @default("NONE") // NONE, PLANTED, ESTABLISHED, MATURE — สถานะหญ้าแฝก
  vetiverRootDepthCm Float   @default(0) // ความลึกรากหญ้าแฝก (ซม.) — ปกติ 200-300 ซม. (2-3 เมตร)
  vetiverPlantDensity Float  @default(0) // ความหนาแน่นปลูก (กอ/ตร.ม.) — ปกติ 5-10 กอ/ตร.ม.
  vetiverErosionPreventionPct Float @default(0) // % ป้องกันการพังทลายจากหญ้าแฝก (60-90%)
  vetiverSedimentAccumulationKg Float @default(0) // ตะกอนดินเพิ่มเติมจากหญ้าแฝก (กก.)
  vetiverCarbonSequestrationKg Float @default(0) // คาร์บอนที่หญ้าแฝกกักไว้ (กก.)
  checkDamId        String?  @unique // ฝายชะลอน้ำประจำชั้น
  checkDam          CheckDam? @relation(fields: [checkDamId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  plot              SoilCarbonPlot @relation(fields: [plotId], references: [plotId], onDelete: Cascade)
  measurements      SoilCarbonMeasurement[]
}

// ฝายชะลอน้ำ (Check Dam) — กักน้ำและตะกอนในแต่ละชั้น
model CheckDam {
  id                String   @id @default(cuid())
  plotId            String
  damId             String   // เช่น DAM-CMD-001-01
  damName           String   @default("")
  damNameTh         String   @default("") // เช่น "ฝายชะลอน้ำชั้นที่ 1"
  damType           String   @default("STONE") // STONE, CONCRETE, LOG, GABION, VEGETATION
  heightM           Float    @default(0) // ความสูงฝาย (เมตร)
  widthM            Float    @default(0) // ความกว้างฝาย (เมตร)
  thicknessM        Float    @default(0) // ความหนาฝาย (เมตร)
  upstreamDepthM    Float    @default(0) // ความลึกน้ำเหนือฝาย (เมตร)
  sedimentDepthCm   Float    @default(0) // ความหนาตะกอนดินหลังฝาย (ซม.)
  sedimentVolumeM3  Float    @default(0) // ปริมาณตะกอนดิน (ลบ.ม.)
  sedimentSOCpct    Float    @default(0) // SOC % ในตะกอนดินหลังฝาย
  sedimentCarbonTc  Float    @default(0) // คาร์บอนในตะกอน (tC)
  flowRateLMin      Float    @default(0) // อัตราไหลผ่านฝาย (ลิตร/นาที)
  flowReductionPct  Float    @default(0) // % ลดอัตราการไหล
  trapEfficiencyPct Float    @default(0) // % ประสิทธิภาพการกักตะกอน
  status            String   @default("ACTIVE") // ACTIVE, DAMAGED, MAINTENANCE, DECOMMISSIONED
  lastInspection    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  plot              SoilCarbonPlot @relation(fields: [plotId], references: [plotId], onDelete: Cascade)
  terrace           TerraceLayer?
}

model SoilCarbonMeasurement {
  id                String   @id @default(cuid())
  plotId            String
  terraceLayerId    String?  // ชั้นปลูกที่วัด (null = วัดรวมทั้งแปลง)
  measurementDate   DateTime
  measurementType   String   @default("FIELD") // FIELD, LAB, REMOTE_SENSING, MODEL
  depthCm           Float    @default(30) // Soil sampling depth in cm
  soilMoisture      Float    @default(0) // %
  soilTemperature   Float    @default(0) // °C
  soilPH            Float    @default(7) // pH value
  bulkDensity       Float    @default(0) // g/cm³
  organicCarbonPct  Float    @default(0) // SOC %
  totalNitrogen     Float    @default(0) // N %
  cec               Float    @default(0) // Cation Exchange Capacity cmol/kg
  aboveGroundBiomass Float   @default(0) // t/ha
  belowGroundBiomass Float   @default(0) // t/ha
  socStock          Float    @default(0) // tC/ha calculated SOC stock
  co2Flux           Float    @default(0) // µmol/m²/s CO₂ flux
  ch4Flux           Float    @default(0) // mg/m²/hr CH₄ flux
  n2oFlux           Float    @default(0) // µg/m²/hr N₂O flux
  // --- ข้อมูลเพิ่มเติมสำหรับพื้นที่ลาดชัน/กักตะกอนดิน ---
  runoffVolumeL     Float    @default(0) // ปริมาณน้ำไหลบ่า (ลิตร)
  sedimentConcGpL   Float    @default(0) // ความเข้มข้นตะกอน (กรัม/ลิตร)
  sedimentLoadKg    Float    @default(0) // ปริมาณตะกอนดิน (กก.)
  erosionRateTpHa   Float    @default(0) // อัตราการพังทลายดิน (ตัน/เฮกแตร์)
  waterFlowRateLMin Float    @default(0) // อัตราการไหลของน้ำ (ลิตร/นาที)
  infiltrationMmHr  Float    @default(0) // อัตราซึมน้ำ (มม./ชม.)
  ingestionMode     String   @default("realtime") // realtime, batch
  qualityFlag       String   @default("RAW") // RAW, VALIDATED, CERTIFIED, REJECTED, ANOMALY
  integrityHash     String   @default("") // SHA-256
  sourceDevice      String   @default("") // Sensor/Lab ID
  notes             String   @default("")
  createdAt         DateTime @default(now())

  plot              SoilCarbonPlot @relation(fields: [plotId], references: [plotId], onDelete: Cascade)
  terraceLayer      TerraceLayer?  @relation(fields: [terraceLayerId], references: [id], onDelete: SetNull)
}

// ─── Low-Carbon Building Agent Models ────────────────────────────────────

model LowCarbonBuilding {
  id                String   @id @default(cuid())
  buildingId        String   @unique // e.g., BLD-BKK-001
  name              String
  nameTh            String   @default("")
  province          String   @default("")
  lat               Float    @default(0)
  lng               Float    @default(0)
  buildingType      String   @default("OFFICE") // OFFICE, RESIDENTIAL, RETAIL, HOSPITAL, SCHOOL, HOTEL, MIXED_USE
  floors            Int      @default(1)
  grossFloorArea    Float    @default(0) // m²
  yearBuilt         Int      @default(2020)
  certificationStd  String   @default("TGBI") // TGBI, LEED, EDGE, TREES, GREEN MARK
  certificationLevel String  @default("UNRATED") // UNRATED, CERTIFIED, SILVER, GOLD, PLATINUM
  baselineEUI       Float    @default(0) // kWh/m²/yr baseline Energy Use Intensity
  projectEUI        Float    @default(0) // kWh/m²/yr project EUI
  baselineEmission  Float    @default(0) // tCO2e/yr baseline
  projectEmission   Float    @default(0) // tCO2e/yr project
  emissionReduction Float    @default(0) // tCO2e/yr
  renewableEnergyPct Float   @default(0) // % renewable energy
  waterReductionPct Float    @default(0) // % water reduction
  materialSavingsPct Float   @default(0) // % material carbon savings
  greenAreaRatio    Float    @default(0) // ratio of green area
  status            String   @default("REGISTERED") // REGISTERED, MONITORING, CERTIFIED, RECERTIFIED, SUSPENDED
  methodology       String   @default("T-VER-BLDG-01") // T-VER-BLDG-01, EDGE, LEED-EB
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  energyRecords     BuildingEnergyRecord[]
  materialRecords   BuildingMaterialRecord[]
  edgeNodeId        String?
  edgeNode          IoTEdgeNode? @relation(fields: [edgeNodeId], references: [id], onDelete: SetNull)
}

model BuildingEnergyRecord {
  id                String   @id @default(cuid())
  buildingId        String
  recordDate        DateTime
  recordType        String   @default("HOURLY") // HOURLY, DAILY, MONTHLY, YEARLY
  electricityKwh    Float    @default(0) // Grid electricity kWh
  hvacKwh           Float    @default(0) // HVAC system kWh
  lightingKwh       Float    @default(0) // Lighting kWh
  equipmentKwh      Float    @default(0) // Plug loads & equipment kWh
  solarGeneration   Float    @default(0) // On-site solar kWh
  windGeneration    Float    @default(0) // On-site wind kWh
  gasUsage          Float    @default(0) // Natural gas m³
  waterUsage        Float    @default(0) // Water m³
  indoorTemp        Float    @default(0) // Avg indoor temperature °C
  indoorHumidity    Float    @default(0) // Avg indoor humidity %
  co2Level          Float    @default(0) // Indoor CO₂ ppm
  occupancyRate     Float    @default(0) // % occupancy
  eui               Float    @default(0) // kWh/m² calculated
  carbonEmission    Float    @default(0) // tCO2e calculated
  ingestionMode     String   @default("realtime") // realtime, batch
  qualityFlag       String   @default("RAW") // RAW, VALIDATED, CERTIFIED, REJECTED, ANOMALY
  integrityHash     String   @default("")
  sourceDevice      String   @default("")
  createdAt         DateTime @default(now())

  building          LowCarbonBuilding @relation(fields: [buildingId], references: [buildingId], onDelete: Cascade)
}

model BuildingMaterialRecord {
  id                String   @id @default(cuid())
  buildingId        String
  materialName      String
  materialNameTh    String   @default("")
  category          String   @default("STRUCTURAL") // STRUCTURAL, ENVELOPE, INTERIOR, MEP, RENEWABLE
  quantity          Float    @default(0)
  unit              String   @default("kg") // kg, m³, m², ton
  carbonFactor      Float    @default(0) // kgCO2e per unit
  embodiedCarbon    Float    @default(0) // total kgCO2e
  recycledContent   Float    @default(0) // % recycled content
  localSource       Boolean  @default(false) // locally sourced within 500km
  supplier          String   @default("")
  createdAt         DateTime @default(now())

  building          LowCarbonBuilding @relation(fields: [buildingId], references: [buildingId], onDelete: Cascade)
}

// ─── User & Authentication ────────────────────────────────────────────────

model FootprintEntry {
  id        String   @id @default(cuid())
  scope     Int // 1, 2, or 3 (GHG Protocol)
  activity  String // activityType key, e.g. diesel, electricity_thailand
  quantity  Float
  unit      String   @default("")
  factor    Float    @default(0) // kgCO2e per unit
  emissions Float // kgCO2e = quantity × factor
  projectId String? // optional link to a project (informational)
  createdAt DateTime @default(now())

  @@index([scope])
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String
  role          String   @default("viewer") // admin, validator, project_developer, buyer, auditor, viewer
  name          String   @default("")
  status        String   @default("ACTIVE") // ACTIVE, SUSPENDED, LOCKED
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([role])
  @@index([status])
}
