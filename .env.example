# dMRV Platform - Environment Configuration
# Copy this file to .env and adjust values as needed
# Usage: cp .env.example .env  (then edit values)

# Database (SQLite) — file path is relative to project root
DATABASE_URL=file:./db/custom.db

# NextAuth.js — REQUIRED for authentication
# Generate a secure secret with: openssl rand -base64 32
# Or use any random string for development
NEXTAUTH_SECRET=change-me-to-a-secure-random-string-at-least-32-chars

# NextAuth URL — the public URL where the app is served
# For local development: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Optional: Node environment
# NODE_ENV=development

# ─── Setup Instructions ───────────────────────────────────────────
# After copying this file to .env:
#   1. bun install                  # install dependencies
#   2. bun run db:push               # create SQLite DB + push schema
#   3. bun run db:seed               # seed 25 demo users + sample data
#   4. bun run dev                   # start dev server on port 3000
#
# Demo login credentials (after seeding):
#   admin/Admin@123, validator/Validator@123, buyer/Buyer@123,
#   auditor/Auditor@123, developer/Developer@123, viewer/Viewer@123
